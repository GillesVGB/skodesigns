{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {"api/site.ts": {"maxDuration": 60}},
  "routes": [
    {"src":"^/(?!api/site(?:/|$)|\\.well-known(?:/|$))(.*)$","dest":"/api/site?path=$1"}
  ]
}
