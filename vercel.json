{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {"api/site.ts": {"maxDuration": 60}},
  "rewrites": [
    {"source":"/","destination":"/api/site?path="},
    {"source":"/:path*","destination":"/api/site?path=:path*"}
  ]
}
